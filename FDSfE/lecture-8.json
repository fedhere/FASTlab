{"version":3,"kind":"Article","sha256":"d4bbb2f84274f96491b3b3b624ae0b66cebc3465832ddc6af28798cb38a383e7","slug":"lecture-8","location":"/Chapter10/Lecture.md","dependencies":[],"frontmatter":{"title":"Learning Questions","content_includes_title":false,"github":"https://github.com/FoxFortino/SaturnineQuail-pedagogy","numbering":{"title":{"offset":1}},"source_url":"https://github.com/FoxFortino/SaturnineQuail-pedagogy/blob/main/Chapter10/Lecture.md","edit_url":"https://github.com/FoxFortino/SaturnineQuail-pedagogy/edit/main/Chapter10/Lecture.md","thumbnail":"/build/VAE_Basic-4271a6bc3f4c3ac6bc4c0eea5cd6ee65.png","thumbnailOptimized":"/build/VAE_Basic-4271a6bc3f4c3ac6bc4c0eea5cd6ee65.webp","exports":[{"format":"md","filename":"Lecture.md","url":"/build/Lecture-1bb4f8ae28e31ad07baa9e292116aed1.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"What is the difference between an inferential and generative neural\nnetwork?","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LEhRBOPd1i"}],"key":"bwsqXh3RVH"}],"key":"lT0Ga8Gkzg"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"What is an autoencoder?","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"leKmCj9qEC"}],"key":"aFwwLSPfKT"}],"key":"F8AXzvRsCR"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"What is a variational autoencoder?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"OWEXSofkyW"}],"key":"b7oGNgjtus"}],"key":"tjov5gO1rA"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"What is the latent space?","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"qa0GmDgzll"}],"key":"Hm1ZaTx5fm"}],"key":"UjTP4C8CbP"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"What is a generative adversarial network?","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"lDa44IzZ4s"}],"key":"kGSqoBjek1"}],"key":"Ue58JlxY7c"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"What is a diffusion model?","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"g5IjdPp0tJ"}],"key":"kA9b1ftjLd"}],"key":"ye5u7dDFxc"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"What is the Transformer?","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ThyspYczIB"}],"key":"F2T1hNJ8zo"}],"key":"AlBm8Ynmxt"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"What is the attention mechanism?","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"HK1YWPBKNv"}],"key":"vMSJSP4I5v"}],"key":"Io69qUwXrh"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"What is a large language model?","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"bV0gTBh8ed"}],"key":"PviiXw2ike"}],"key":"aCH3JY6qAW"}],"key":"vYo5coybQ6"},{"type":"heading","depth":2,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Introduction","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Wx0SZ3DLrR"}],"identifier":"introduction","label":"Introduction","html_id":"introduction","implicit":true,"key":"CFJXv7Lx8z"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"In the last lesson, we explored inferential neural networks, models that\nmake predictions from data. For example, a neural network can be trained\non a dataset of handwritten digits so that it can classify what digit an\nimage contains. The model’s input is an image, and its output is a\nlabel. But what if we want to create new data instead of classifying (or\nregressing) it? What if we want to generate a new image of a handwritten\ndigit that doesn’t exist in the training set? This is the domain of\n","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"FcksqvqEod"},{"type":"strong","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"generative neural networks.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"E5GTXKpDFV"}],"key":"jEIIXkunHA"}],"key":"J7cHcYRNDn"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Generative models learn the underlying distribution of the training\ndata. Once trained, they can sample from this distribution to create new\ndata that “resembles” (or is consistent with) the training set.\nGenerative models can produce images, text, music and video that appear\nhuman-made. This is its greatest strength, but it also presents the\ngreatest dilemma, which we will discuss at the end of the lesson.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"wDtXHUP3cQ"}],"key":"UBTwBg7cw5"},{"type":"heading","depth":2,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"Autoencoders","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"lFDKxXdX25"}],"identifier":"autoencoders","label":"Autoencoders","html_id":"autoencoders","implicit":true,"key":"xVZJS3n5he"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"An ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"MbXY7GCwIz"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"autoencoder","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"kBV8iQyK1V"}],"key":"pfuaFyAzhh"},{"type":"text","value":" is a neural network that learns to reconstruct its\ninput. It consists of two components: an encoder and a decoder, which\ncan almost be considered two separate models. The encoder takes the\ninput data and compresses it into a lower-dimensional representation\ncalled the ","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"qliVzpa3fL"},{"type":"strong","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"latent space.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"CJK6xMk2pa"}],"key":"AWyzi5ndtX"},{"type":"text","value":" The decoder takes this compressed\nrepresentation and reconstructs the original input. Just like any model,\nthis one needs a loss: the network is trained to minimize the difference\nbetween the input and the reconstruction --- the reconstruction loss.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"E9j0MXJ5Le"}],"key":"seP9pIxckE"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Consider a dataset of handwritten digits. One such popular dataset\nexists called the ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"yhTbq0nkfL"},{"type":"inlineCode","value":"MNIST","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"khMacFDE86"},{"type":"text","value":" dataset. Each image in the dataset is\n","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"nzofLC30Gi"},{"type":"inlineMath","value":"28 \\times 28\\text{ pixels}","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>28</mn><mo>×</mo><mn>28</mn><mtext> pixels</mtext></mrow><annotation encoding=\"application/x-tex\">28 \\times 28\\text{ pixels}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">28</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\">28</span><span class=\"mord text\"><span class=\"mord\"> pixels</span></span></span></span></span>","key":"Ghd7b3C3Si"},{"type":"text","value":". An autoencoder for ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"jBYuQKBvIy"},{"type":"inlineCode","value":"MNIST","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"k08NuVoBQH"},{"type":"text","value":" might have an\nencoder that compresses the image represented by\n","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"oSZCG3Xx5p"},{"type":"inlineMath","value":"28\\times28=784\\text{ numbers}","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>28</mn><mo>×</mo><mn>28</mn><mo>=</mo><mn>784</mn><mtext> numbers</mtext></mrow><annotation encoding=\"application/x-tex\">28\\times28=784\\text{ numbers}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">28</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">28</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord\">784</span><span class=\"mord text\"><span class=\"mord\"> numbers</span></span></span></span></span>","key":"Pc38BBXSzy"},{"type":"text","value":" into just ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"uEv1UAvL3o"},{"type":"text","value":"16","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"lmeQrtBtkd"},{"type":"text","value":" numbers. These ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"BSBWg0l0he"},{"type":"text","value":"16","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"egqatAbfku"},{"type":"text","value":"\nnumbers constitute the latent space. The decoder then takes those ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"i7AF9gC29S"},{"type":"text","value":"16","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"f4fCpcrIxS"},{"type":"text","value":"\nnumbers and reconstructs a ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"Qgi9HOqP6w"},{"type":"inlineMath","value":"28 \\times 28\\text{ pixel}","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>28</mn><mo>×</mo><mn>28</mn><mtext> pixel</mtext></mrow><annotation encoding=\"application/x-tex\">28 \\times 28\\text{ pixel}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">28</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\">28</span><span class=\"mord text\"><span class=\"mord\"> pixel</span></span></span></span></span>","key":"gX8Jq9f5MR"},{"type":"text","value":". The network\nlearns to preserve the most important features of the digits, its shape,\nthe width of each line, the orientation, etc.\n","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"yyh5KH0CiR"},{"type":"link","url":"#fig:vae","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"1.12","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"HzH0Q9imwS"}],"urlSource":"#fig:vae","key":"SE6OWRNoie"},{"type":"text","value":"{reference-type=“ref+label” reference=“fig:vae”} shows\nan example architecture diagram of an autoencoder.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"jxZvUkoGZ6"}],"key":"w6YqBxO5uK"},{"type":"image","url":"/build/VAE_Basic-4271a6bc3f4c3ac6bc4c0eea5cd6ee65.png","alt":"An example (variational) autoencoder architecture. Image credit:EugenioTL (Wikipedia)","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"QqXbv1fX2S","urlSource":"../figures_pedagogy/VAE_Basic.png","urlOptimized":"/build/VAE_Basic-4271a6bc3f4c3ac6bc4c0eea5cd6ee65.webp"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"We talked before about how convolutional neural networks (CNNs) are\nparticularly well-suited to dealing with image data. Thus, you may\nimagine that an autoencoder could make use of convolutions too. The\nconvolution can certainly be used to create this latent space. However,\nwhat operation do we use to increase the dimensions of the data from the\nlatent space? This is done using the transpose of the convolution\noperation. Transposed convolution (sometimes called\n“deconvolution”","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"j8rEtvBAuA"},{"type":"footnoteReference","identifier":"21","label":"21","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"enumerator":"21","key":"IEe7I9nh35"},{"type":"text","value":") increases the size of the image, rather than\ndecreases it as the convolution operation does. Transposed convolution\nlearns the best way to increase the resolution from the data.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"nRpxvyrZPY"}],"key":"kJ7ulSsCB3"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"text","value":"The autoencoder can be extended to perform more advanced tasks. For\nexample, we can mask parts of the input --- either random pixels or\nentire regions are hidden from the model during training --- and train\nthe network to reconstruct the full image from the partial input. This\nforces the network to learn a richer representation of the data. Or we\ncan train it to improve the resolution or quality of an image (Instagram\nand TikTok filters that do this could very well be based on this\ntechnology).","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"fax7ishL5W"}],"key":"wJkaN76i5d"},{"type":"heading","depth":2,"position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"children":[{"type":"text","value":"Variational Autoencoders","position":{"start":{"line":86,"column":1},"end":{"line":86,"column":1}},"key":"IBGfS4kxRI"}],"identifier":"variational-autoencoders","label":"Variational Autoencoders","html_id":"variational-autoencoders","implicit":true,"key":"WwhMNQiYQk"},{"type":"paragraph","position":{"start":{"line":88,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"A standard autoencoder learns a deterministic mapping from input to\nlatent space. Given an input, the encoder always produces the same\nlatent representation. This works for reconstruction, but it makes\ngeneration difficult. If we observe the distribution of values that the\nlatent space takes for each digit, then we can sample from those\ndistributions, feed them into the decoder, and then produce an entirely\nnew image of a digit. But if we do this, we may end up choosing latent\nspace parameters that do not correspond to any real data.","position":{"start":{"line":88,"column":1},"end":{"line":88,"column":1}},"key":"p0ZAGf2nff"}],"key":"KFxejnfhbX"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"XzZgZjyz00"},{"type":"strong","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"variational autoencoder","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"buuvc28Ool"}],"key":"SeUH0ZL9wH"},{"type":"text","value":" (VAE) solves this problem by learning a\nprobability distribution over the latent space. Instead of outputting a\nsingle point, the encoder outputs a mean and a variance for each latent\ndimension. The decoder then samples from this distribution to generate\nnew data.","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"WJCtuqQdxj"}],"key":"mlZxJsaztk"},{"type":"paragraph","position":{"start":{"line":103,"column":1},"end":{"line":113,"column":1}},"children":[{"type":"text","value":"The VAE has a special loss function with two components. The\nreconstruction loss term measures how well the decoder reconstructs the\ninput, but the ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"OYBP7csmj5"},{"type":"strong","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"children":[{"type":"text","value":"KL divergence","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"yKYJeVbwQw"}],"key":"hznywKmOcX"},{"type":"text","value":" term measures how close the learned\nlatent distribution is to a standard normal distribution. The\nKullback--Leibler (KL) divergence is a measure of how one probability\ndistribution differs from another. This term penalizes the model during\ntraining if the latent space is not smooth and continuous. This allows\nus to then sample from the latent space and generate new data that looks\nplausible. If a VAE were trained on the ","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"YYCpqCEHCO"},{"type":"inlineCode","value":"MNIST","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"UT3r82WRFN"},{"type":"text","value":" dataset, we could sample\nthe latent space at different points to generate images of digits drawn\nwith different styles.","position":{"start":{"line":103,"column":1},"end":{"line":103,"column":1}},"key":"G36qTEtamR"}],"key":"Rkpz40TGzH"},{"type":"heading","depth":2,"position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"children":[{"type":"text","value":"Generative Adversarial Networks","position":{"start":{"line":115,"column":1},"end":{"line":115,"column":1}},"key":"T8vRZKcu88"}],"identifier":"generative-adversarial-networks","label":"Generative Adversarial Networks","html_id":"generative-adversarial-networks","implicit":true,"key":"dEuWPjvDVn"},{"type":"paragraph","position":{"start":{"line":117,"column":1},"end":{"line":125,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"sMOKHh11wh"},{"type":"strong","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"generative adversarial network","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"CexnYij7jd"}],"key":"fSHdqlJMhL"},{"type":"text","value":" (GAN) takes a different approach to\ngeneration. Instead of learning a latent space, a GAN uses two networks\nthat compete against each other. The ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"kfHckhng5D"},{"type":"strong","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"generator","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"LIMRkiNdxc"}],"key":"seoodhgCfJ"},{"type":"text","value":" creates fake data\nfrom random noise. The ","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"PpmgBAYMXT"},{"type":"strong","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"children":[{"type":"text","value":"discriminator","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"oWwpch6G22"}],"key":"JxNPQCrly8"},{"type":"text","value":" tries to distinguish real data\nfrom fake data. The two networks are trained together in an adversarial\ngame. The generator creates images with the express purpose of trying to\nfool the discriminator. Over time, the generator becomes better at\ncreating realistic data as the discriminator becomes better at detecting\nfakes.","position":{"start":{"line":117,"column":1},"end":{"line":117,"column":1}},"key":"i1n5sFaNK3"}],"key":"fSHL0xOs1C"},{"type":"paragraph","position":{"start":{"line":127,"column":1},"end":{"line":131,"column":1}},"children":[{"type":"text","value":"For ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"W3Jrf3BIz1"},{"type":"inlineCode","value":"MNIST","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"oJrORlIMw5"},{"type":"text","value":", the generator takes a random noise vector as input and\noutputs a ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"CBbUDtHe7Y"},{"type":"inlineMath","value":"28 \\times 28","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mn>28</mn><mo>×</mo><mn>28</mn></mrow><annotation encoding=\"application/x-tex\">28 \\times 28</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7278em;vertical-align:-0.0833em;\"></span><span class=\"mord\">28</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">×</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:0.6444em;\"></span><span class=\"mord\">28</span></span></span></span>","key":"HaLIc9tEJb"},{"type":"text","value":" image of a digit. The discriminator receives\nboth real ","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"q1VuQX9Fd3"},{"type":"inlineCode","value":"MNIST","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"O53JHwaH5M"},{"type":"text","value":" images and generated images, and tries to classify\nthem as real or fake. As training progresses, the generator learns to\nproduce images that look like real digits.","position":{"start":{"line":127,"column":1},"end":{"line":127,"column":1}},"key":"Gr787g0246"}],"key":"hEpLiAPxrq"},{"type":"paragraph","position":{"start":{"line":133,"column":1},"end":{"line":135,"column":1}},"children":[{"type":"text","value":"GANs can produce high-quality, realistic images, but the training can be\nunstable. The generator may suffer from ","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"huCgAXpodM"},{"type":"emphasis","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"children":[{"type":"text","value":"mode collapse,","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"OuOT86Ctp0"}],"key":"rQqbuK4RWk"},{"type":"text","value":" where it\nproduces only a few types of outputs.","position":{"start":{"line":133,"column":1},"end":{"line":133,"column":1}},"key":"hP0GriJwkb"}],"key":"NoJCP6JyLK"},{"type":"heading","depth":2,"position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"children":[{"type":"text","value":"Diffusion models","position":{"start":{"line":137,"column":1},"end":{"line":137,"column":1}},"key":"pwqbZyh0gK"}],"identifier":"diffusion-models","label":"Diffusion models","html_id":"diffusion-models","implicit":true,"key":"dR0LtazEPM"},{"type":"paragraph","position":{"start":{"line":139,"column":1},"end":{"line":146,"column":1}},"children":[{"type":"strong","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"Diffusion models","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"ka7mOfer3M"}],"key":"Hr0xDxqqGY"},{"type":"text","value":" work by gradually adding noise to data and then\nlearning to reverse the process. In the ","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"o32P7vEoZJ"},{"type":"strong","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"forward process,","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"r7gaSK7x3m"}],"key":"FQIqhU1dyX"},{"type":"text","value":" noise is\nadded to an image step-by-step. After enough steps, the image becomes\nonly random noise. In the ","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"AbKwCbLwg5"},{"type":"strong","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"children":[{"type":"text","value":"reverse process,","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"LS9FCqgdTe"}],"key":"TVF71P94VZ"},{"type":"text","value":" the model learns to\nremove the noise step by step, recovering the original image. Once\ntrained, a diffusion model can generate new images by starting with pure\nrandom noise and iteratively applying the learned denoising process.\nAfter enough steps, the noise becomes a coherent image.","position":{"start":{"line":139,"column":1},"end":{"line":139,"column":1}},"key":"vTj73er0F8"}],"key":"wzfJsgAdeU"},{"type":"paragraph","position":{"start":{"line":148,"column":1},"end":{"line":150,"column":1}},"children":[{"type":"text","value":"Diffusion models produce high-quality, diverse outputs and are more\nstable to train than GANs. However, they are also slow to generate\nimages because they require many iterative steps.","position":{"start":{"line":148,"column":1},"end":{"line":148,"column":1}},"key":"w1rpf4OPoJ"}],"key":"yH4cArNzyS"},{"type":"image","url":"/build/evaluateGAI-6311227abddbde34268da026efdfb853.png","alt":"The strengths and weaknesses of each of the three main generative AIframeworks: Variational Autoencoders and Normalizing Flows, GenerativeAdversarial Networks, and Diffusion Models. Fromhttps://www.nvidia.com/en-us/glossary/generative-ai/.","position":{"start":{"line":152,"column":1},"end":{"line":152,"column":1}},"key":"vRKhRvceQG","urlSource":"../figures_pedagogy/evaluateGAI.png","urlOptimized":"/build/evaluateGAI-6311227abddbde34268da026efdfb853.webp"},{"type":"heading","depth":2,"position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"children":[{"type":"text","value":"VAE, GAN or Diffusion?","position":{"start":{"line":157,"column":1},"end":{"line":157,"column":1}},"key":"mpdevRynOo"}],"identifier":"vae-gan-or-diffusion","label":"VAE, GAN or Diffusion?","html_id":"vae-gan-or-diffusion","implicit":true,"key":"bx6mFAxWsZ"},{"type":"paragraph","position":{"start":{"line":159,"column":1},"end":{"line":164,"column":1}},"children":[{"type":"text","value":"The previous sections contained guidance on the pros and cons of three\ngenerative AI approaches commonly used for image generation.\n","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"jnfqG8jAx7"},{"type":"link","url":"#fig:genai","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"children":[{"type":"text","value":"1.13","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"PqP2DtZVvU"}],"urlSource":"#fig:genai","key":"jt0mJrOzw6"},{"type":"text","value":"\nconveys these pros and cons graphically to help you choose what to use\nbased on your requirements on accuracy, diversity of generated data, and\ncomputational constraints.","position":{"start":{"line":159,"column":1},"end":{"line":159,"column":1}},"key":"e5f0chvGnA"}],"key":"n6Bxx7ALzY"},{"type":"heading","depth":2,"position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"children":[{"type":"text","value":"Transformers","position":{"start":{"line":166,"column":1},"end":{"line":166,"column":1}},"key":"sqHkkuL25k"}],"identifier":"transformers","label":"Transformers","html_id":"transformers","implicit":true,"key":"ATGkSe2Oxq"},{"type":"paragraph","position":{"start":{"line":168,"column":1},"end":{"line":175,"column":1}},"children":[{"type":"text","value":"Generative models are not limited to images. How can models be trained\nto generate realistic sentences? Language is sequential and structured;\nthe meaning of a word depends on the words around it. As we discussed\nearlier in this chapter, recurrent neural networks (RNNs) can work with\nsequential data, but they struggle to deal with long-range dependencies\n( the effect of words that are separated from each other by many words)\nwithout long short-term memory (LSTM). The ","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"key":"zvazUx7gLJ"},{"type":"strong","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"children":[{"type":"text","value":"Transformer","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"key":"aKkUB7niFz"}],"key":"PMlkFTvlaK"},{"type":"text","value":" architecture\nsolved this problem in another way.","position":{"start":{"line":168,"column":1},"end":{"line":168,"column":1}},"key":"oFYkWisIbS"}],"key":"zfkRDRYcfM"},{"type":"paragraph","position":{"start":{"line":177,"column":1},"end":{"line":183,"column":1}},"children":[{"type":"text","value":"The key innovation of the Transformer is the ","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"sSkQbQJrQR"},{"type":"strong","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"children":[{"type":"text","value":"attention mechanism.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"G6sWlkgNyq"}],"key":"CTiGbbs8SA"},{"type":"text","value":"\nAttention allows a model to focus on the relevant parts of the input.\nFor text, attention lets each word “look at” all other words in the\nsequence. This captures relationships between distant words. For\nexample, in the sentence “The cat that chased the mouse was hungry,”\nattention helps the model connect “was” with “cat” even though many\nwords separate them.","position":{"start":{"line":177,"column":1},"end":{"line":177,"column":1}},"key":"zkgBaI92JR"}],"key":"sgg84qLp8J"},{"type":"paragraph","position":{"start":{"line":185,"column":1},"end":{"line":191,"column":1}},"children":[{"type":"text","value":"The original Transformer has an encoder-decoder structure. The encoder\nprocesses the input sequence, and the decoder generates the output\nsequence. Some models only use the decoder. These decoder-only models\n(like GPT) are designed for autoregressive generation. They process the\ninput sentence and generate the output one word at a time.","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"key":"GA4MH1JsD7"},{"type":"footnoteReference","identifier":"22","label":"22","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"enumerator":"22","key":"MHy2blrJSH"},{"type":"text","value":" The\nmodel predicts the next word in the sequence based on all previous\nwords.","position":{"start":{"line":185,"column":1},"end":{"line":185,"column":1}},"key":"N92iNsQ5wT"}],"key":"gcenT0PiD1"},{"type":"paragraph","position":{"start":{"line":193,"column":1},"end":{"line":196,"column":1}},"children":[{"type":"text","value":"Consider the sentence: “The quick brown fox jumps over the lazy.” One\nsuch language model could learn to predict the next word, “dog,” based\non the text of the sentence and the context it learned throughout\ntraining. Indeed, such a model could continue predicting words forever.","position":{"start":{"line":193,"column":1},"end":{"line":193,"column":1}},"key":"oG8Px9awyP"}],"key":"dQOPP1kdCO"},{"type":"heading","depth":2,"position":{"start":{"line":198,"column":1},"end":{"line":198,"column":1}},"children":[{"type":"text","value":"Foundation Models and Pretraining","position":{"start":{"line":198,"column":1},"end":{"line":198,"column":1}},"key":"ZEhVdb45G1"}],"identifier":"foundation-models-and-pretraining","label":"Foundation Models and Pretraining","html_id":"foundation-models-and-pretraining","implicit":true,"key":"e2MJIecBLV"},{"type":"paragraph","position":{"start":{"line":200,"column":1},"end":{"line":204,"column":1}},"children":[{"type":"text","value":"A ","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"pW5Ipbtnvo"},{"type":"strong","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"children":[{"type":"text","value":"foundation model","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"zln41c1ssT"}],"key":"rY5JhGh710"},{"type":"text","value":" is a large neural network","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"sEWLCOfPAD"},{"type":"footnoteReference","identifier":"23","label":"23","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"enumerator":"23","key":"dHqUGbyQm7"},{"type":"text","value":" trained on a\nmassive dataset on a reconstruction task ( regenerating the data, like\nwe have seen in the autoencoder case or reconstructing missing pixels in\nimages). This way, these models learn general patterns and relationships\namong the data, and then the models are adapted to many different tasks.","position":{"start":{"line":200,"column":1},"end":{"line":200,"column":1}},"key":"QuHYEVBL5j"}],"key":"vpPU59wF4V"},{"type":"paragraph","position":{"start":{"line":206,"column":1},"end":{"line":214,"column":1}},"children":[{"type":"strong","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"children":[{"type":"text","value":"Pretraining","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"ybrMvwoNRQ"}],"key":"xcbMZjyGpK"},{"type":"text","value":" is the process of training a model on a large, general\ndataset before fine-tuning it for a specific task. For example, a\nlanguage model can be trained on billions of words from the internet,\nand after this pretraining, it can be ","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"SrsRivsvEg"},{"type":"strong","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"children":[{"type":"text","value":"fine-tuned","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"kHVeGXhLuL"}],"key":"ahnamLomPv"},{"type":"text","value":" on a smaller\ndataset for a specific task. For example, you can pretrain on a British\nEnglish corpus and fine-tune on an American English corpus. Or you can\npretrain on a large corpus of artwork and fine-tune on Andy Warhol alone\nto generate art in his style (we will address ethical implications in a\nmoment).","position":{"start":{"line":206,"column":1},"end":{"line":206,"column":1}},"key":"JzWC5wrN3J"}],"key":"WeJbKUKJd8"},{"type":"paragraph","position":{"start":{"line":216,"column":1},"end":{"line":219,"column":1}},"children":[{"type":"strong","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"children":[{"type":"text","value":"Large language models","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"key":"olfYAMfe5E"}],"key":"ZatZDy0df9"},{"type":"text","value":" (LLMs) are foundation models for text. They\ncan generate human-like text, answer questions and even write code. They\nare the result of scaling up the Transformer architecture to enormous\nsizes. GPT, Claude, Grok, Gemini and DeepSeek are all examples of LLMs.","position":{"start":{"line":216,"column":1},"end":{"line":216,"column":1}},"key":"thZbxVo1Mk"}],"key":"PszQaWzPt0"},{"type":"heading","depth":2,"position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"children":[{"type":"text","value":"Ethics of Generation","position":{"start":{"line":221,"column":1},"end":{"line":221,"column":1}},"key":"xo5za7aoNm"}],"identifier":"ethics-of-generation","label":"Ethics of Generation","html_id":"ethics-of-generation","implicit":true,"key":"jljnqgOaNH"},{"type":"paragraph","position":{"start":{"line":223,"column":1},"end":{"line":231,"column":1}},"children":[{"type":"text","value":"Generative models raise significant ethical concerns. They learn from\nhuman data --- our text, our images, etc. --- which contains human\nbiases. These biases can be amplified by the model, leading to harmful\noutputs when generative models are applied to tasks like hiring, law\nenforcement, healthcare and translation. Gender and racial biases are\nsome of the most visible biases in these models, where they will make\nobviously harmful assumptions about people based on their race and\ngender. These stereotypes exist in the modern world, and these training\nsets are so large that it’s impossible to completely de-bias them.","position":{"start":{"line":223,"column":1},"end":{"line":223,"column":1}},"key":"e8iFIEGnM7"}],"key":"EHEc2I2oVI"},{"type":"paragraph","position":{"start":{"line":233,"column":1},"end":{"line":236,"column":1}},"children":[{"type":"text","value":"Generative models are often misused to lie and mislead. They can create\na convincing fake news post, advertisement or video so quickly and\neasily. The existence of these models threatens public trust in the\nworld around them.","position":{"start":{"line":233,"column":1},"end":{"line":233,"column":1}},"key":"ydxdwSg3v3"}],"key":"qJa5hsLQ1Y"},{"type":"paragraph","position":{"start":{"line":238,"column":1},"end":{"line":244,"column":1}},"children":[{"type":"text","value":"Most generative models are trained on data scraped from the internet\nwithout permission (from the website or from the authors). This includes\ncopyrighted works, personal data, and art. It’s now possible for an\nartist’s entire portfolio to be uploaded to the dataset of a generative\nimage model, and then ask the model to produce a new image in that\nartist’s style. The data ","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"AOogp3Jegy"},{"type":"emphasis","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"is","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"UNVFVsxTVO"}],"key":"jQJMjBT5Dd"},{"type":"text","value":" the model. If the data is stolen, then any\noutput of the model represents theft.","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"yKt0nycQtg"}],"key":"ZiG2UzA6Cx"},{"type":"footnoteDefinition","identifier":"21","label":"21","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":246,"column":1},"end":{"line":248,"column":1}},"children":[{"type":"text","value":"The term “deconvolution” does not actually refer to a transposed\nconvolution, though the two terms are often used interchangeably.\nAvoid using “deconvolution.”","position":{"start":{"line":246,"column":1},"end":{"line":246,"column":1}},"key":"mcDc7NTbg2"}],"key":"dze1zqUfuB"}],"enumerator":"21","key":"Q7dw3A01wp"},{"type":"footnoteDefinition","identifier":"22","label":"22","position":{"start":{"line":246,"column":1},"end":{"line":246,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":250,"column":1},"end":{"line":251,"column":1}},"children":[{"type":"text","value":"These models don’t process words but “tokens,” mathematical\nrepresentations of words or word fragments.","position":{"start":{"line":250,"column":1},"end":{"line":250,"column":1}},"key":"HVV5AUm66e"}],"key":"jxlVuU4EDc"}],"enumerator":"22","key":"YIgrpAlEWL"},{"type":"footnoteDefinition","identifier":"23","label":"23","position":{"start":{"line":250,"column":1},"end":{"line":250,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"children":[{"type":"text","value":"“Large” meaning many parameters.","position":{"start":{"line":253,"column":1},"end":{"line":253,"column":1}},"key":"s2WHo4vdkR"}],"key":"ZWo2UYyzLr"}],"enumerator":"23","key":"Ws7ZDj7hwg"}],"key":"q6nPhVgOPR"}],"key":"hU4gZzRiUe"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Grade: / 19","url":"/exercises-2","group":"Chapter 9: Inferential Neural Networks"},"next":{"title":"Lesson10 .1 VAE","url":"/lesson10-1-vae","group":"Chapter 10: Generative Neural Networks"}}},"domain":"http://localhost:3000"}